# Endpoint backend NSS yang dipakai oleh route server Next.js.
# Jangan isi credential/token asli di file ini.
NSS_API_URL=https://your-backend-endpoint.example

# Opsional, hanya jika integrasi frontend lain membutuhkannya.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Opsional: ganti tile provider tanpa mengubah komponen map.
# Jika provider diganti, sesuaikan attribution sesuai ketentuan provider tersebut.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors"

# MySQL untuk /internal dan konten artikel/arsip.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gadai_sakti_app
DB_PASSWORD=change_this_password
DB_NAME=gadai_sakti
DB_CONNECTION_LIMIT=10

# Lama session login internal dalam hari. Default 1 hari.
INTERNAL_SESSION_DAYS=1
